# Куди Vite dev-server проксує /api, /sanctum, /broadcasting, /storage тощо.
VITE_API_PROXY_TARGET=http://127.0.0.1:8591

# Порожньо = той самий origin (через proxy). Абсолютний URL лише якщо API
# на іншому origin (потрібні CORS_ALLOWED_ORIGINS + SANCTUM_STATEFUL_DOMAINS).
VITE_API_URL=

# Laravel Reverb. Браузер підключається до ws://localhost:3000/app/<key>,
# Vite проксує це на VITE_REVERB_PROXY_TARGET.
VITE_REVERB_APP_KEY=portal-key
VITE_REVERB_PROXY_TARGET=http://127.0.0.1:6001
# Лише для прямого підключення в обхід proxy:
# VITE_REVERB_HOST=127.0.0.1
# VITE_REVERB_PORT=6001
# VITE_REVERB_SCHEME=http

# Debug-режим окремих сторінок (Welcome). Порожньо = вимкнено.
# VITE_APP_DEBUG=
