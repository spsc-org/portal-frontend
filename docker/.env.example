# Порт, на якому SPA доступна в браузері (http://<ip-vm>:SPA_PORT).
# Цей host:port треба додати в SANCTUM_STATEFUL_DOMAINS бекенду.
SPA_PORT=8090

# Laravel API і Reverb — без завершального "/".
# Бекенд на тому ж Docker-хості: http://host.docker.internal:<порт>.
API_UPSTREAM=http://host.docker.internal:8080
REVERB_UPSTREAM=http://host.docker.internal:6001

# Runtime (env контейнера → /config.js, зміна → лише перезапуск контейнера).
PORTAL_REVERB_APP_KEY=portal-key
PORTAL_APP_DEBUG=

# Build-time (зміна → docker compose build).
VITE_API_URL=
